# Canonical MCP cost constants for phased-execution.
# SINGLE SOURCE OF TRUTH (F5), exactly like sizing.env: scripts/phase-graph.sh
# sources this file, viewer/server/analysis/graph.ts reads the same file, and
# references/sizing.md documents these exact numbers. Change them here only.
#
# Plain KEY=VALUE (sourced by bash 3.2) — no spaces around '=', integers in tokens.
#
# Why a phase with MCP servers is a bigger phase:
#
#   Every attached server puts its name, its server instructions (capped at 2KB
#   by the CLI) and its tool names into the system prompt of EVERY turn. Tool
#   search — on by default — defers the full schemas until Claude searches for
#   one, which is why the cost is a few hundred tokens per server rather than a
#   few thousand, and why it is sublinear: the tenth server adds far less than
#   the first. MCP_SURCHARGE_MAX is that flattening, expressed as a ceiling.
#
#   The larger cost is not in this file because it is not a working-set cost:
#   connecting or disconnecting a server mid-session busts the prompt cache and
#   re-reads the whole context (references/sizing.md). That is the reason MCP is
#   attached at a PHASE BOUNDARY here and never mid-phase.

MCP_SURCHARGE=1500          # per attached server, added to the phase's working set
MCP_SURCHARGE_MAX=12000     # ceiling — tool search means server N+1 costs less than N
