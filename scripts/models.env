# F5-style single source: the MODEL vocabulary shared by the bash engine
# (phase-graph.sh sources this file) and the console (viewer/server/runner/
# models.ts parses the same file). Change a list only here — a drift test on
# the viewer side pins the two readers, and the hardcoded fallback, together.
#
# Why this file exists at all. The model vocabulary used to be one array
# (MODEL_FALLBACK) plus five independent regexes — the limit-bucket matcher,
# the per-model wall matcher, the budget resolver, the account family matcher
# and the plan-prose sniffer — plus two bash globs and two more in the client.
# None was derived from any other, so every one of them had to be found and
# edited by hand whenever the lineup moved, and the ones that were missed
# failed SILENTLY: a per-phase `- **Model:** claude-opus-5[1m]` was dropped on
# the floor by the route and the phase ran on the run's default instead.
#
# NOT here on purpose: the per-session budget NUMBERS. Those stay in
# sizing.env, which is the F5 source for sizing and is documented by
# references/sizing.md. This file says which model belongs to which budget
# CLASS; sizing.env says what a class is worth.

# Model aliases the CLI accepts, STRONGEST FIRST.
#
# The order is load-bearing twice over: it is the escalation ladder itself
# (escalateModel walks left, nextModel walks right), and it is the precedence
# order for matching a full id, which is done by substring — so a longer name
# that contains a shorter one must come first.
MODEL_ALIASES="fable opus sonnet haiku"

# The canonical full id per alias, so a plan, a route or an operator may write
# either spelling and both resolve to one model. A full id is matched by
# family rather than by exact equality, which is deliberate: the CLI ships
# dated ids (claude-haiku-4-5-20251001) and a new one must not become a 400
# the day it lands.
MODEL_IDS="fable=claude-fable-5 opus=claude-opus-5 sonnet=claude-sonnet-5 haiku=claude-haiku-4-5"

# Aliases the CLI takes that select a MODE rather than a model. They are
# accepted at the doors and passed through verbatim; they have no rank, so
# they never take part in escalation or fallback.
MODEL_MODES="opusplan"

# The context-window suffix the CLI understands on either spelling
# (opus[1m], claude-opus-5[1m]). It is a window selector, not a model: the
# family, the usage bucket and the escalation rank of a suffixed name are
# those of its base model. Only the BUDGET differs, which is the whole reason
# the console has to be able to see it.
MODEL_1M_SUFFIX="[1m]"

# Families the 1M window is actually available on, measured against the CLI
# rather than assumed: fable, opus and sonnet answer, and haiku[1m] comes back
# "the long context beta is not yet available for this subscription".
#
# This list is what a PICK LIST should offer. It is deliberately NOT what the
# door validates: isKnownModel() still accepts haiku[1m], because whether a
# window is enabled is a subscription fact that can change between one day and
# the next, and a console that hard-refuses a name the CLI takes would be wrong
# the morning it changes. Offer the three; accept the fourth.
MODEL_1M_CAPABLE="fable opus sonnet"

# Aliases whose per-session budget class is the big one; haiku falls to
# BUDGET_HAIKU and anything unrecognised to BUDGET_DEFAULT. `mythos` is listed
# without an id or a rank because plans in the wild name it and the budget
# resolver has always honoured it.
MODEL_BIG="fable opus sonnet mythos"
