{
  "name": "phase-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local web console for the phased-execution system: plans, phases, handoffs, status, prompts and statistics.",
  "engines": {
    "node": ">=22.18 <23 || >=23.6"
  },
  "scripts": {
    "start": "node scripts/check-stamp.mjs && node server/index.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck:client": "tsc -p client/tsconfig.json --noEmit && tsc -p client/tsconfig.sw.json --noEmit",
    "lint:client": "eslint client/src shared --max-warnings 0",
    "lint:client:fix": "eslint client/src shared --fix",
    "format": "prettier --write \"client/src/**/*.{ts,tsx,js,mjs}\" \"shared/**/*.{js,mjs}\" \"scripts/**/*.mjs\" eslint.config.js vite.config.ts",
    "format:check": "prettier --check \"client/src/**/*.{ts,tsx,js,mjs}\" \"shared/**/*.{js,mjs}\" \"scripts/**/*.mjs\" eslint.config.js vite.config.ts",
    "dev": "vite",
    "build": "vite build && node scripts/stamp-build.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "test:client": "vitest run",
    "test:client:watch": "vitest"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.33.0",
    "marked": "^18.0.10",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
