#!/usr/bin/env bash
# Phase Console — local viewer for phased-execution plans, phases and handoffs.
#
#   ./run                          pick the source directory in the browser
#   ./run --root ~/code/your-repo        open a directory straight away
#   ./run --allow-writes           enable the guarded write verbs
#
# Run it as a background agent instead, so it survives a closed terminal, a
# logout and a crash (see deploy/agent.sh):
#
#   ./run --install-agent --root ~/code/your-repo
#   ./run --agent-status | --agent-restart | --agent-log [-f] | --uninstall-agent
#
# One install runs one console per project. The lifecycle words take an
# instance (a name, an id, or nothing for the project you are standing in):
#
#   ./run start | stop | restart | status | logs | list | open [<instance>]
#
# The server is plain Node run as TypeScript directly, which needs >= 22.18
# (or >= 23.6 — 23.0-23.5 still kept type stripping behind a flag). The
# client is BUILT output: on a fresh clone run `cd viewer && npm ci && npm run
# build` first — until then the console serves a page saying exactly that.
# `deploy/agent.sh install|update` runs the build for you.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Agent management is a system operation, not a server one — hand it straight
# to the script that owns the supervisor (launchd on macOS, systemd on Linux)
# and never start a second console here. Every verb now takes an optional
# instance (a name, an id, `--instance <sel>` or `--root <dir>`), so the rest of
# the line goes over untouched instead of being dropped.
case "${1:-}" in
  --install-agent)   shift; exec bash "$here/deploy/agent.sh" install "$@" ;;
  --uninstall-agent) shift; exec bash "$here/deploy/agent.sh" uninstall "$@" ;;
  --agent-status)    shift; exec bash "$here/deploy/agent.sh" status "$@" ;;
  --agent-start)     shift; exec bash "$here/deploy/agent.sh" start "$@" ;;
  --agent-stop)      shift; exec bash "$here/deploy/agent.sh" stop "$@" ;;
  --agent-restart)   shift; exec bash "$here/deploy/agent.sh" restart "$@" ;;
  --agent-update)    shift; exec bash "$here/deploy/agent.sh" update "$@" ;;
  --agent-log)       shift; exec bash "$here/deploy/agent.sh" log "$@" ;;
esac

# The bare lifecycle words belong to the one CLI that owns them — `start` falls
# back to a foreground run, `list`/`open` are not supervisor operations at all,
# and re-deciding any of that here would be a second implementation of the same
# grammar. A clone gets the same verbs as an npm install by delegating.
case "${1:-}" in
  start|stop|restart|status|log|logs|update|list|open)
    exec node "$here/../bin/phase-console.mjs" "$@" ;;
esac

# A node that satisfies the floor (>=22.18, or >=23.6 — 23.0-23.5 kept type
# stripping behind a flag).
node_ok() { "$1" -e 'const [maj, min] = process.versions.node.split(".").map(Number);
process.exit(maj >= 24 || (maj === 23 && min >= 6) || (maj === 22 && min >= 18) ? 0 : 1)' 2>/dev/null; }

# PATH's node is not the last word — the same search the Desktop launcher does.
# A machine whose default `node` is an old nvm alias (v22.6 was seen doing
# exactly this) would otherwise refuse a command the docs promised works,
# while a perfectly good v24 sat one directory over. nvm's versions are walked
# newest-first because a plain glob sorts v10 before v8.
if ! command -v node >/dev/null 2>&1 || ! node_ok "$(command -v node)"; then
  candidates="/opt/homebrew/bin /usr/local/bin $HOME/.volta/bin"
  if [ -d "$HOME/.nvm/versions/node" ]; then
    for v in $(ls -1 "$HOME/.nvm/versions/node" 2>/dev/null | sort -rV); do
      candidates="$candidates $HOME/.nvm/versions/node/$v/bin"
    done
  fi
  for candidate in $candidates; do
    if [ -x "$candidate/node" ] && node_ok "$candidate/node"; then
      PATH="$candidate:$PATH"
      export PATH
      break
    fi
  done
fi

if ! command -v node >/dev/null 2>&1; then
  echo "phase-console: node is required (>= 22.18, or >= 23.6) — none found on PATH," >&2
  echo "in Homebrew, /usr/local, volta or nvm." >&2
  exit 1
fi
if ! node_ok "$(command -v node)"; then
  echo "phase-console: node $(node -v) is too old — >=22.18 or >=23.6 runs TypeScript directly," >&2
  echo "and no newer node was found in Homebrew, /usr/local, volta or nvm." >&2
  exit 1
fi

# Warn — never build — when the built client is missing or older than the code.
node "$here/scripts/check-stamp.mjs" || true

# Node refuses to type-strip .ts under any node_modules directory — an npm
# global install lives there, and its tarball ships a pre-stripped
# server/index.js for exactly this case. Everywhere else the .ts is the truth.
entry="$here/server/index.ts"
case "$here" in
  */node_modules/*) [ -f "$here/server/index.js" ] && entry="$here/server/index.js" ;;
esac

exec node "$entry" "$@"
