#!/usr/bin/env bash
# Phase Console — local viewer for phased-execution plans, phases and handoffs.
#
#   ./run                          pick the source directory in the browser
#   ./run --root ~/code/your-repo        open a directory straight away
#   ./run --allow-writes           enable the guarded write verbs
#
# Run it as a background agent instead, so it survives a closed terminal, a
# logout and a crash (see deploy/agent.sh):
#
#   ./run --install-agent --root ~/code/your-repo
#   ./run --agent-status | --agent-restart | --agent-log [-f] | --uninstall-agent
#
# No install step: the server is plain Node (>= 22.6, which runs TypeScript
# directly) and the client is native ES modules.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Agent management is a system operation, not a server one — hand it straight
# to the script that owns launchd and never start a second console here.
case "${1:-}" in
  --install-agent)   shift; exec bash "$here/deploy/agent.sh" install "$@" ;;
  --uninstall-agent) exec bash "$here/deploy/agent.sh" uninstall ;;
  --agent-status)    exec bash "$here/deploy/agent.sh" status ;;
  --agent-restart)   exec bash "$here/deploy/agent.sh" restart ;;
  --agent-log)       shift; exec bash "$here/deploy/agent.sh" log "$@" ;;
esac

if ! command -v node >/dev/null 2>&1; then
  echo "phase-console: node is required (>= 22.6)" >&2
  exit 1
fi

major="$(node -p 'process.versions.node.split(".")[0]')"
minor="$(node -p 'process.versions.node.split(".")[1]')"
if [ "$major" -lt 22 ] || { [ "$major" -eq 22 ] && [ "$minor" -lt 6 ]; }; then
  echo "phase-console: node $(node -v) is too old — 22.6+ runs TypeScript directly" >&2
  exit 1
fi

exec node "$here/server/index.ts" "$@"
